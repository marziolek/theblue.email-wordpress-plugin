{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "theblue-email/form",
	"version": "1.0.0",
	"title": "theblue.email form",
	"category": "widgets",
	"icon": "email-alt",
	"description": "A signup form from your theblue.email account.",
	"keywords": [ "newsletter", "signup", "subscribe", "email" ],
	"textdomain": "theblue-email-forms",
	"attributes": {
		"key": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": {
			"margin": true,
			"padding": true
		}
	},
	"editorScript": "file:./editor.js",
	"editorStyle": "file:./editor.css",
	"render": "file:./render.php"
}
