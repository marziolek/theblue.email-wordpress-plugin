includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    # Hooks, options and other plugins hand over whatever they like, whatever
    # their doc comments say, so the plugin checks types at runtime on purpose.
    treatPhpDocTypesAsCertain: false
    # Set by the site owner in wp-config.php; the stub's value is only a placeholder.
    dynamicConstantNames:
        - TBEF_BEHIND_CLOUDFLARE
    paths:
        - theblue-email-forms.php
        - includes
        - blocks/form/render.php
    scanFiles:
        - tests/stubs/integrations.php
    bootstrapFiles:
        - tests/stubs/constants.php
